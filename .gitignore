# 大体积产物、第三方工具与运行时数据不入库

# 内核/固件原始产物（309MB+7.4GB）；只保留 5.15.137 的推导记录文本
artifacts/*
!artifacts/5.15.137/
artifacts/5.15.137/*
!artifacts/5.15.137/README.md
!artifacts/5.15.137/SHA256SUMS
!artifacts/5.15.137/extractor-analysis.txt
!artifacts/5.15.137/extractor-conf.conf
!artifacts/5.15.137/extractor.json
ota/
image/
offsets/
intel/
# 这几个只忽略根目录下的试验输出：必须锚定，否则 run/ 会连
# iqoo-neo9-ghostlock-pc/internal/run/ 一起吞掉（真踩过）。
/ksu/
/exploit/
/run/
/gpu-root/
build/
publish/
_research/
_src/

# 与本项目无关的宿主机工具（zig/go 工具链、DSH 会话脚本）
tools/*
!tools/port/
!tools/mockadb/
!tools/README.md
# adb 协议参考实现：定位签名/分帧/OKAY 顺序三个坑全靠它，值得入库
!tools/adb_probe.py
!tools/adb_mitm.py

# 编译产物
**/bin/
*.exe
*.dll
*.so
*.o
*.a
*.zip
# vrpatch.ko 是随工具内嵌分发的 payload，必须入库：不能一刀切忽略 *.ko
*.ko
!iqoo-neo9-ghostlock-pc/internal/assets/payload/vrpatch.ko

# 内核/固件镜像与中间产物
*.img
*.bin
*.elf
*.raw
*.mbn
*.zst
*.zstd

# 运行状态与日志
autoroot/state/
*.log
*.jsonl
session-*
*.transcript.md
# 假 adb 的运行时状态
tools/mockadb/mock-state.txt

# Python
__pycache__/
*.pyc

# 编辑器/系统
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# APK 工程：keystore 与构建产物不入库
apk/build/
apk/keystore.jks
apk/lib/arm64-v8a/libksud.so

# 调试截图（16 张、共 4.9MB），装机验证时截的，不入库
apk/screen-*.png

# 私钥绝不入库（这是公开仓库）。文件缺失时 AdbBridge 自动退回到设备自己生成
# 一对密钥，并在主页提示把公钥登记到 /data/misc/adb/adb_keys。
apk/assets/adbkey.der

# APK 工程的 payload 与内核模块必须入库：它们不是编译产物，是运行必需的输入
!apk/lib/arm64-v8a/libghostlock.so
!apk/assets/vrpatch.ko
!apk/assets/profile.bin
